# Copy to .env (gitignored) and fill in real values for a production build.
# AdMob IDs — get these from https://admob.google.com (one app + one unit per format).
# Leave blank in dev: the app uses MockAdService and never contacts AdMob.

# App-level AdMob application ID (also goes in AndroidManifest meta-data — see ANDROID.md).
VITE_ADMOB_APP_ID=

# Ad unit IDs.
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_BANNER_ID=

# Set to "true" to force AdMob test ads even in a release build.
VITE_ADMOB_TESTING=false
